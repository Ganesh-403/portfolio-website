// Cloudflare Workers config: serve the built static site from dist/ with no Worker script.
// Without this file, `wrangler deploy` auto-configures an SSR adapter and the build fails.
// "name" must match the Worker's name in the Cloudflare dashboard.
// Response headers come from public/_headers.
{
  "name": "portfolio-website",
  "compatibility_date": "2026-10-31",
  // Serve at portfolio-website.gkambli70.workers.dev; no per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
