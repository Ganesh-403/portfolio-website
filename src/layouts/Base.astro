---
import '../styles/global.css';
import { person, experience } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = person.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${person.name}` : `${person.name}, ${person.headline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.jpg', Astro.site);
const education = experience.find((role) => role.kind === 'Education');

// Google's ProfilePage markup: https://developers.google.com/search/docs/appearance/structured-data/profile-page
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: canonical.href,
  dateModified: new Date().toISOString(),
  mainEntity: {
    '@type': 'Person',
    name: person.name,
    url: Astro.site?.href,
    image: ogImage.href,
    jobTitle: person.role,
    worksFor: { '@type': 'Organization', name: person.company, url: person.companyUrl },
    homeLocation: { '@type': 'Place', name: person.location },
    alumniOf: education && { '@type': 'CollegeOrUniversity', name: education.org },
    knowsAbout: ['Go', 'DuckDB', 'Business intelligence', 'AI agents', 'Model Context Protocol', 'Release engineering'],
    sameAs: [person.links.github, person.links.linkedin],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="profile" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${person.name}, ${person.headline}`} />
    <meta property="profile:first_name" content="Ganesh" />
    <meta property="profile:last_name" content="Kambli" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f4efe4" />

    <!-- Before the first paint: the remembered edition (or the system's), and on the first visit of
         a session the short masthead intro. Inline so nothing flashes. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let theme = null;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        root.dataset.theme = theme;
        if (theme === 'dark') document.querySelector('meta[name="theme-color"]')?.setAttribute('content', '#0f0e0c');
        try {
          if (!sessionStorage.getItem('intro') && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
            root.classList.add('intro');
            sessionStorage.setItem('intro', '1');
          }
        } catch {}
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="intro-curtain" aria-hidden="true">
      <span class="intro-mark">GK</span>
      <span class="intro-count"></span>
    </div>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas class="ambient" aria-hidden="true"></canvas>
    <slot />
    <script>
      import { tilt, magnet } from '../scripts/tilt';
      import { pointer, scramble } from '../scripts/pointer';
      tilt();
      magnet();
      pointer();
      scramble();

      // The ambient 3D layer is decoration: it loads once the page is idle, and not at all under
      // reduced motion or Save-Data.
      const ambient = document.querySelector<HTMLCanvasElement>('canvas.ambient');
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      if (ambient && !saveData && matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const load = () => import('../scripts/ambient').then(({ mountAmbient }) => mountAmbient(ambient));
        if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2500 });
        else setTimeout(load, 500);
      }
    </script>
  </body>
</html>
