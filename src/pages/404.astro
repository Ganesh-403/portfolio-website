---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="Page not found" noindex>
  <Header />
  <main id="main" class="page missing">
    <h1>This page doesn't exist</h1>
    <p class="lede">The link may be old or mistyped. Everything on this site lives on one page.</p>
    <p><a class="button primary" href="/">Go to the home page</a></p>
  </main>
  <Footer />
</Base>

<style>
  .missing {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-block: clamp(4rem, 3rem + 8vw, 9rem);
  }

  h1 {
    font-size: var(--step-3);
  }
</style>
