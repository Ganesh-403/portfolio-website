---
import { person, projects, moreProjects } from '../data/profile';

const count = ['No', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine'][moreProjects.length] ?? moreProjects.length;
---

<section class="section" id="projects" aria-labelledby="projects-name">
  <h2 class="section-name" id="projects-name">Projects</h2>
  <div class="section-body">
    <ul class="projects">
      {
        projects.map((project) => (
          <li class="project">
            <div class="head">
              <h3>
                <a href={project.repo}>{project.name}</a>
              </h3>
              <p class="meta">
                {project.stars ? (
                  <span class="stars" aria-label={`${project.stars} GitHub stars`}>
                    ★ {project.stars}
                  </span>
                ) : null}
                <a href={project.repo}>
                  Code<span class="visually-hidden"> for {project.name}</span>
                </a>
                {project.links?.map((link) => (
                  <a href={link.url}>
                    {link.label}
                    <span class="visually-hidden"> for {project.name}</span>
                  </a>
                ))}
              </p>
            </div>
            <p class="summary">{project.summary}</p>
            <details class="disclosure how">
              <summary>
                How it works<span class="visually-hidden">: {project.name}</span>
              </summary>
              <div class="how-body">
                <p>{project.body}</p>
                <p class="stack">{project.stack.join(', ')}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <details class="disclosure earlier">
      <summary>{count} earlier projects</summary>
      <ul class="more">
        {
          moreProjects.map((project) => (
            <li>
              <a href={project.url}>{project.name}</a>
              <span class="muted">{project.body}</span>
              {project.demo && (
                <a class="demo" href={project.demo}>
                  Live demo<span class="visually-hidden"> for {project.name}</span>
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <p class="all">
        <a href={`${person.links.github}?tab=repositories`}>Every repository on GitHub</a>
      </p>
    </details>
  </div>
</section>

<style>
  .projects {
    border-top: 1px solid var(--rule);
  }

  .project {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
  }

  h3 {
    font-size: var(--step-2);
    font-weight: 750;
    letter-spacing: -0.02em;
  }

  h3 a {
    color: var(--ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 1.25rem;
    font-size: var(--step--1);
  }

  .stars {
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }

  .summary {
    margin-top: 0.35rem;
    font-size: var(--step-1);
    line-height: 1.4;
  }

  /* The disclosure sits under the one-line summary, with its marker right after the label. */
  .how {
    margin-top: 0.5rem;
  }

  .how > summary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 24px;
    color: var(--graphite);
    font-size: var(--step--1);
  }

  .how > summary::after {
    margin-left: 0;
    width: 0.65rem;
    height: 0.65rem;
  }

  .how > summary:hover {
    color: var(--ink);
  }

  .how-body {
    max-width: var(--measure);
    padding-top: 0.6rem;
  }

  .stack {
    margin-top: 0.6rem;
  }

  .earlier {
    margin-top: 2rem;
  }

  .earlier > summary {
    padding-block: 0.75rem;
    font-weight: 700;
  }

  .earlier > summary:hover {
    color: var(--accent);
  }

  .more {
    margin-top: 0.5rem;
    border-top: 1px solid var(--rule);
  }

  .more li {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--rule);
  }

  .more li > a:first-child {
    min-width: 11rem;
    font-weight: 650;
  }

  .more .muted {
    flex: 1 1 18rem;
  }

  .all {
    margin-block: 1.25rem 0.5rem;
  }
</style>
