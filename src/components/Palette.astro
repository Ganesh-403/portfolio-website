---
import { person } from '../data/profile';

// A command palette: Ctrl+K (⌘K on a Mac), "/", or the button in the header. Everything in it is
// also a plain link or button somewhere on the page; this is the fast way there. `also` holds the
// other words people might type for a command.
const commands = [
  { id: 'work', group: 'Go to', label: 'LeapView, my work at Flid AI', href: '#work', also: 'work job pull requests chart' },
  { id: 'projects', group: 'Go to', label: "Things I've built", href: '#projects', also: 'projects repos code reposage honeycloud' },
  { id: 'freelance', group: 'Go to', label: 'Freelance', href: '#freelance', also: 'hire work with me offer' },
  { id: 'background', group: 'Go to', label: 'Background', href: '#background', also: 'experience education research papers open source' },
  { id: 'contact', group: 'Go to', label: 'Contact', href: '#contact', also: 'message form hire' },
  { id: 'copy', group: 'Do', label: `Copy my email (${person.email})`, action: 'copy' },
  { id: 'mail', group: 'Do', label: 'Write me an email', href: `mailto:${person.email}` },
  { id: 'theme', group: 'Do', label: 'Switch light or dark', action: 'theme', also: 'theme mode daylight night' },
  { id: 'github', group: 'Open', label: 'GitHub', href: person.links.github },
  { id: 'linkedin', group: 'Open', label: 'LinkedIn', href: person.links.linkedin },
  { id: 'top', group: 'Go to', label: 'Back to the top', href: '#top', also: 'home start' },
];
---

<dialog class="palette" aria-label="Command palette" data-email={person.email}>
  <form method="dialog">
    <div class="field">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
      <input
        type="text"
        role="combobox"
        aria-expanded="true"
        aria-controls="palette-list"
        aria-autocomplete="list"
        aria-label="Search commands"
        placeholder="Jump to a section, copy my email…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd>esc</kbd>
    </div>
    <ul id="palette-list" role="listbox" aria-label="Commands">
      {
        commands.map((c) => (
          <li
            id={`cmd-${c.id}`}
            role="option"
            aria-selected="false"
            data-href={c.href}
            data-action={c.action}
            data-text={`${c.group} ${c.label} ${c.also ?? ''}`.toLowerCase()}
          >
            <span class="group">{c.group}</span>
            <span>{c.label}</span>
          </li>
        ))
      }
    </ul>
    <p class="empty" hidden>Nothing matches. Try “email” or “projects”.</p>
    <p class="foot">
      <span><kbd>↑</kbd><kbd>↓</kbd> to choose</span>
      <span><kbd>enter</kbd> to go</span>
      <span class="note" role="status" aria-live="polite"></span>
    </p>
  </form>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.palette');
  const input = dialog?.querySelector('input');
  const options = [...(dialog?.querySelectorAll<HTMLLIElement>('[role="option"]') ?? [])];
  const empty = dialog?.querySelector<HTMLElement>('.empty');
  const note = dialog?.querySelector<HTMLElement>('.note');

  if (dialog && input) {
    let active = 0;
    const visible = () => options.filter((o) => !o.hidden);

    const highlight = (index: number) => {
      const list = visible();
      if (!list.length) return input.removeAttribute('aria-activedescendant');
      active = (index + list.length) % list.length;
      options.forEach((o) => o.setAttribute('aria-selected', 'false'));
      list[active].setAttribute('aria-selected', 'true');
      input.setAttribute('aria-activedescendant', list[active].id);
      list[active].scrollIntoView({ block: 'nearest' });
    };

    const filter = () => {
      const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
      for (const o of options) o.hidden = !words.every((w) => o.dataset.text?.includes(w));
      if (empty) empty.hidden = visible().length > 0;
      highlight(0);
    };

    const open = () => {
      if (dialog.open) return;
      input.value = '';
      if (note) note.textContent = '';
      filter();
      dialog.showModal();
      input.focus();
    };

    const run = async (option: HTMLLIElement) => {
      const { href, action } = option.dataset;
      if (action === 'copy') {
        try {
          await navigator.clipboard.writeText(dialog.dataset.email ?? '');
          if (note) note.textContent = 'Email copied';
        } catch {
          if (note) note.textContent = dialog.dataset.email ?? '';
        }
        return;
      }
      dialog.close();
      if (action === 'theme') document.querySelector<HTMLButtonElement>('[data-theme-switch]')?.click();
      else if (href?.startsWith('#')) document.querySelector(href)?.scrollIntoView();
      else if (href) location.href = href;
    };

    input.addEventListener('input', filter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        highlight(active + (event.key === 'ArrowDown' ? 1 : -1));
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const choice = visible()[active];
        if (choice) run(choice);
      }
    });
    for (const option of options) {
      option.addEventListener('click', () => run(option));
      option.addEventListener('pointermove', () => highlight(visible().indexOf(option)));
    }
    // A click on the backdrop (the dialog itself, outside the form) closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    addEventListener('keydown', (event) => {
      const typing = (event.target as HTMLElement).closest('input, textarea, [contenteditable]');
      if ((event.key === 'k' || event.key === 'K') && (event.metaKey || event.ctrlKey)) {
        event.preventDefault();
        dialog.open ? dialog.close() : open();
      } else if (event.key === '/' && !typing && !dialog.open) {
        event.preventDefault();
        open();
      }
    });
    document.querySelectorAll('[data-palette-open]').forEach((button) => button.addEventListener('click', open));
  }
</script>

<style>
  .palette {
    width: min(36rem, calc(100vw - 2rem));
    max-height: min(32rem, calc(100svh - 6rem));
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--glass-line);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    color: var(--fg);
    box-shadow: 0 3rem 6rem -2rem var(--haze);
    backdrop-filter: blur(24px) saturate(150%);
    overflow: hidden;
  }

  .palette::backdrop {
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(4px);
  }

  form {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }

  .field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .field svg {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: var(--muted);
    stroke-width: 2;
    stroke-linecap: round;
  }

  input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--fg);
    font: inherit;
    outline: none;
  }

  input::placeholder {
    color: var(--muted);
  }

  ul {
    flex: 1;
    padding: 0.5rem;
    overflow-y: auto;
  }

  li {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    padding: 0.65rem 0.8rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
  }

  li[hidden] {
    display: none;
  }

  li[aria-selected='true'] {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .group {
    flex: none;
    width: 3.5rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .empty {
    padding: 1rem 1.3rem;
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    padding: 0.7rem 1.1rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  .note {
    margin-left: auto;
    color: var(--accent);
  }

  kbd {
    display: inline-block;
    min-width: 1.4rem;
    margin-right: 0.2rem;
    padding: 0.05rem 0.35rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .palette[open] {
      animation: pop 260ms var(--ease-out);
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-0.75rem) scale(0.97);
    }
  }
</style>
