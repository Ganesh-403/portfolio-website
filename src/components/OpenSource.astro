---
import { upstream, community } from '../data/profile';
import { monthYear, plainTitle } from '../lib/format';
---

<section class="section" id="open-source" aria-labelledby="oss-name">
  <h2 class="section-name" id="oss-name">Open source</h2>
  <div class="section-body">
    <p class="intro">Outside LeapView, I send fixes upstream to projects I use and help run open-source programs for students.</p>

    <h3>Merged upstream</h3>
    <ul class="upstream">
      {
        upstream.map((pr) => (
          <li>
            <span class="repo mono">{pr.repo}</span>
            <a href={pr.url}>{plainTitle(pr.title)}</a>
            <span class="muted when">{monthYear(pr.merged)}</span>
          </li>
        ))
      }
    </ul>

    <h3>Programs</h3>
    <ul class="community">
      {
        community.map((item) => (
          <li>
            <p class="what">
              {item.title}
              <span class="muted when">{item.period}</span>
            </p>
            {item.body && <p class="muted">{item.body}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .intro {
    max-width: var(--measure);
  }

  h3 {
    margin-top: 2.25rem;
    font-size: var(--step-1);
  }

  .upstream,
  .community {
    margin-top: 0.75rem;
    border-top: 1px solid var(--rule);
  }

  .upstream li,
  .community li {
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--rule);
  }

  /* The next section's top rule closes the list. */
  .community li:last-child {
    border-bottom: 0;
    padding-bottom: 0;
  }

  .upstream li {
    display: grid;
    gap: 0.15rem 1rem;
  }

  @media (min-width: 44rem) {
    .upstream li {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .upstream .repo {
      grid-column: 1 / -1;
    }
  }

  .repo {
    color: var(--graphite);
    font-size: 0.82rem;
  }

  .when {
    font-size: var(--step--1);
    white-space: nowrap;
  }

  .what {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
    font-weight: 650;
  }

  .what .when {
    font-weight: 400;
  }
</style>
