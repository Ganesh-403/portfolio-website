---
// LeapView's idea, applied to my own work: a metric defined in code, rendered as a chart you can explore.
// Numbers come from the committed GitHub snapshot (npm run sync:github).
import { leapview } from '../data/profile';
import { dayMonth as short, dayMonthYear } from '../lib/format';

const { mergedPRs, firstMerged, lastMerged } = leapview.stats;
// The total covers everything; the chart shows the most recent weeks so bars stay readable.
const weekly = leapview.stats.weekly.slice(-12);

const max = Math.max(...weekly.map((w) => w.merged), 1);
const peak = weekly.reduce((a, b) => (b.merged > a.merged ? b : a), weekly[0]);
const barWidth = 10;
const gap = 4;
const height = 64;
const width = Math.max(weekly.length * (barWidth + gap) - gap, 1);
const range = firstMerged && lastMerged ? `${short(firstMerged)} to ${dayMonthYear(lastMerged)}` : '';
const resting = peak ? `Busiest week: ${peak.merged}, week of ${short(peak.week)}` : '';

const yaml: [string, string][] = [
  ['metric', 'merged_pull_requests'],
  ['source', 'github.com/flidai/leapview'],
  ['author', 'Ganesh-403'],
  ['grain', 'week'],
];
---

<figure class="metric" data-metric>
  <div class="file">
    <span class="path">metrics/contributions.yaml</span>
    <pre><code>{yaml.map(([key, value]) => <span class="line"><span class="key">{key}:</span> <span class="value">{value}</span></span>)}</code></pre>
  </div>
  <div class="render">
    <p class="figure"><span class="number">{mergedPRs}</span> merged pull requests</p>
    {range && <p class="range muted">{range}</p>}
    {
      peak && (
        <>
          <p class="readout" aria-hidden="true" data-readout data-resting={resting}>
            {resting}
          </p>
          <svg class="chart" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" aria-hidden="true">
            {weekly.map((w, i) => {
              const h = Math.max(1.5, (w.merged / max) * height);
              return (
                <g class="week" data-label={`${w.merged} merged, week of ${short(w.week)}`}>
                  {/* A full-height hit area makes short bars as easy to point at as tall ones. */}
                  <rect class="hit" x={i * (barWidth + gap) - gap / 2} y="0" width={barWidth + gap} height={height} />
                  <rect class="bar" x={i * (barWidth + gap)} y={height - h} width={barWidth} height={h} style={`--i:${i}`} />
                </g>
              );
            })}
          </svg>
          <div class="axis muted" aria-hidden="true">
            <span>Week of {short(weekly[0].week)}</span>
            <span>Week of {short(weekly.at(-1)!.week)}</span>
          </div>
          <table class="visually-hidden">
            <caption>My merged pull requests in LeapView, by week</caption>
            <thead>
              <tr>
                <th scope="col">Week of</th>
                <th scope="col">Merged</th>
              </tr>
            </thead>
            <tbody>
              {weekly.map((w) => (
                <tr>
                  <th scope="row">{short(w.week)}</th>
                  <td>{w.merged}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </>
      )
    }
  </div>
</figure>

<script>
  // Pointing at (or tapping) a week shows its count in the readout; leaving the chart or pressing
  // Escape puts the busiest week back. Screen readers get the same numbers from the table.
  document.querySelectorAll<HTMLElement>('[data-metric]').forEach((card) => {
    const readout = card.querySelector<HTMLElement>('[data-readout]');
    const chart = card.querySelector<SVGSVGElement>('.chart');
    if (!readout || !chart) return;
    const resting = readout.dataset.resting ?? '';
    let active: Element | null = null;

    const show = (week: Element | null) => {
      active?.classList.remove('active');
      active = week;
      week?.classList.add('active');
      readout.textContent = week?.getAttribute('data-label') ?? resting;
      readout.classList.toggle('pointing', Boolean(week));
    };

    chart.addEventListener('pointerover', (event) => show((event.target as Element).closest('.week')));
    chart.addEventListener('pointerdown', (event) => show((event.target as Element).closest('.week')));
    chart.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') show(null);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') show(null);
    });
  });
</script>

<style>
  .metric {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) + 4px);
    background: var(--raised);
    overflow: hidden;
  }

  .file {
    padding: 1rem 1.25rem 1.1rem;
    background: var(--code);
    border-bottom: 1px solid var(--rule);
  }

  .path {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  pre {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.86rem;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .line {
    display: block;
  }

  .key {
    color: var(--graphite);
  }

  .value {
    color: var(--ink);
  }

  .render {
    padding: 1.25rem 1.25rem 1rem;
  }

  .figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    font-weight: 650;
  }

  .number {
    font-size: var(--step-3);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .range {
    margin-top: 0.35rem;
    font-size: var(--step--1);
  }

  .readout {
    margin-top: 1.1rem;
    min-height: 1.6em;
    color: var(--graphite);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .readout.pointing {
    color: var(--ink);
    font-weight: 650;
  }

  .chart {
    width: 100%;
    height: 5rem;
    margin-top: 0.4rem;
    cursor: crosshair;
    touch-action: manipulation;
  }

  .hit {
    fill: transparent;
  }

  .bar {
    fill: var(--signal);
    transform-box: fill-box;
    transform-origin: bottom;
    transition: opacity 150ms;
  }

  /* While one week is pointed at, the others step back. */
  .chart:has(.active) .bar {
    opacity: 0.35;
  }

  .chart .active .bar {
    opacity: 1;
  }

  /* Bars grow as the chart scrolls into view, where scroll-driven animations exist. */
  /* The timeline is the chart's own box; SVG shapes don't have one to track. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .chart {
        view-timeline: --chart block;
      }

      .bar {
        animation: grow linear both;
        animation-timeline: --chart;
        animation-range: entry calc(var(--i) * 3%) cover 40%;
      }
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  .axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    font-size: 0.78rem;
  }
</style>
