---
// My LeapView pull requests as a chart you can explore: point at or tap a week to read it.
// Numbers come from the committed GitHub snapshot (npm run sync:github).
import { leapview } from '../data/profile';
import { dayMonth as short, dayMonthYear } from '../lib/format';

const { mergedPRs, firstMerged, lastMerged } = leapview.stats;
// The total covers everything; the chart shows the most recent weeks so bars stay readable.
const weekly = leapview.stats.weekly.slice(-12);

const max = Math.max(...weekly.map((w) => w.merged), 1);
const peak = weekly.reduce((a, b) => (b.merged > a.merged ? b : a), weekly[0]);
const barWidth = 10;
const gap = 4;
const height = 64;
const width = Math.max(weekly.length * (barWidth + gap) - gap, 1);
const range = firstMerged && lastMerged ? `${short(firstMerged)} to ${dayMonthYear(lastMerged)}` : '';
const resting = peak ? `Busiest week: ${peak.merged}, week of ${short(peak.week)}` : '';
---

<figure class="metric" data-metric>
  <p class="figure">
    <span class="number">{mergedPRs}</span>
    <span class="unit">merged pull requests{range && <span class="range">, {range}</span>}</span>
  </p>
  {
    peak && (
      <>
        <p class="readout" aria-hidden="true" data-readout data-resting={resting}>
          {resting}
        </p>
        <svg class="chart" viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="bar-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" style="stop-color: var(--lamp)" />
              <stop offset="1" style="stop-color: var(--ember)" />
            </linearGradient>
          </defs>
          {weekly.map((w, i) => {
            const h = Math.max(1.5, (w.merged / max) * height);
            return (
              <g class="week" data-label={`${w.merged} merged, week of ${short(w.week)}`}>
                {/* A full-height hit area makes short bars as easy to point at as tall ones. */}
                <rect class="hit" x={i * (barWidth + gap) - gap / 2} y="0" width={barWidth + gap} height={height} />
                <rect class="bar" x={i * (barWidth + gap)} y={height - h} width={barWidth} height={h} rx="1.5" style={`--i:${i}`} />
              </g>
            );
          })}
        </svg>
        <div class="axis" aria-hidden="true">
          <span>Week of {short(weekly[0].week)}</span>
          <span>Week of {short(weekly.at(-1)!.week)}</span>
        </div>
        {/* The same numbers as a table, on request: for screen readers, keyboards and anyone who prefers exact values. */}
        <details class="disclosure numbers">
          <summary>Weekly numbers</summary>
          <table>
            <caption class="visually-hidden">My merged pull requests in LeapView, by week</caption>
            <thead>
              <tr>
                <th scope="col">Week of</th>
                <th scope="col">Merged</th>
              </tr>
            </thead>
            <tbody>
              {weekly.map((w) => (
                <tr>
                  <th scope="row">{short(w.week)}</th>
                  <td>{w.merged}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      </>
    )
  }
</figure>

<script>
  // Pointing at (or tapping) a week shows its count in the readout; leaving the chart, tapping
  // elsewhere or pressing Escape puts the busiest week back. The table has the same numbers.
  document.querySelectorAll<HTMLElement>('[data-metric]').forEach((card) => {
    const readout = card.querySelector<HTMLElement>('[data-readout]');
    const chart = card.querySelector<SVGSVGElement>('.chart');
    if (!readout || !chart) return;
    const resting = readout.dataset.resting ?? '';
    let active: Element | null = null;

    const show = (week: Element | null) => {
      active?.classList.remove('active');
      active = week;
      week?.classList.add('active');
      readout.textContent = week?.getAttribute('data-label') ?? resting;
      readout.classList.toggle('pointing', Boolean(week));
    };

    chart.addEventListener('pointerover', (event) => show((event.target as Element).closest('.week')));
    chart.addEventListener('pointerdown', (event) => show((event.target as Element).closest('.week')));
    chart.addEventListener('pointerleave', (event) => {
      if (event.pointerType === 'mouse') show(null);
    });
    document.addEventListener('pointerdown', (event) => {
      if (active && !chart.contains(event.target as Node)) show(null);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') show(null);
    });
  });
</script>

<style>
  .metric {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    margin: 0;
  }

  .number {
    display: block;
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
  }

  .unit {
    display: block;
    margin-top: 0.6rem;
    color: var(--stone);
    font-size: var(--step--1);
  }

  .readout {
    min-height: 1.6em;
    margin-top: 1.75rem;
    color: var(--stone);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .readout.pointing {
    color: var(--lamp);
    font-weight: 650;
  }

  .chart {
    width: 100%;
    height: clamp(8rem, 6rem + 6vw, 11rem);
    margin-top: 0.75rem;
    cursor: crosshair;
    touch-action: manipulation;
  }

  .hit {
    fill: transparent;
  }

  .bar {
    fill: url(#bar-fill);
    transform-box: fill-box;
    transform-origin: bottom;
  }

  /* While one week is pointed at, the others step back. */
  .chart:has(.active) .bar {
    opacity: 0.3;
  }

  .chart .active .bar {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .bar {
      transition: opacity 150ms;
    }
  }

  /* Bars grow as the chart scrolls into view, where scroll-driven animations exist.
     The timeline is the chart's own box; SVG shapes don't have one to track. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .chart {
        view-timeline: --chart block;
      }

      .bar {
        animation: grow linear both;
      }

      /* A separate rule: the minifier would otherwise fold the timeline into the animation
         shorthand, which browsers reject. */
      .chart .bar {
        animation-timeline: --chart;
        animation-range: entry calc(var(--i) * 3%) entry 100%;
      }
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }

  .axis {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
    color: var(--stone);
    font-size: 0.8rem;
  }

  .numbers {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .numbers > summary {
    padding-block: 0.75rem 0.25rem;
    color: var(--stone);
  }

  .numbers > summary:hover {
    color: var(--plaster);
  }

  /* No bottom margin: it would escape the animating panel and make it jump when it finishes. */
  table {
    width: 100%;
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  th,
  td {
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 400;
    text-align: left;
  }

  thead th {
    color: var(--stone);
  }

  td,
  thead th:last-child {
    text-align: right;
  }
</style>
