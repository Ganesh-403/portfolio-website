---
import { experience, upstream, community, papers, awards, certifications, person } from '../data/profile';
import { monthYear, plainTitle } from '../lib/format';

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<section class="section" id="background" aria-labelledby="background-name">
  <h2 class="section-name" id="background-name">Background</h2>

  <div class="layout">
    <div class="block card experience">
      <h3 class="sub">Experience</h3>
      <ol class="roles">
        {
          experience.map((role) =>
            role.points ? (
              <li>
                <details class="disclosure role-details">
                  <summary>
                    <span class="period">
                      {role.start} to {role.end}
                    </span>
                    <span class="what">
                      <strong class="title">{role.title}</strong>
                      <span class="org">
                        {role.place ? `${role.org}, ${role.place}` : role.org}
                        <span class="kind">{role.kind}</span>
                      </span>
                    </span>
                  </summary>
                  <ul class="points">
                    {role.points.map((point) => (
                      <li>{point}</li>
                    ))}
                  </ul>
                </details>
              </li>
            ) : (
              <li class="role">
                <span class="period">
                  {role.start} to {role.end}
                </span>
                <span class="what">
                  <strong class="title">{role.title}</strong>
                  <span class="org">
                    {role.place ? `${role.org}, ${role.place}` : role.org}
                    <span class="kind">{role.kind}</span>
                  </span>
                  {role.note && <span class="note">{role.note}</span>}
                </span>
              </li>
            ),
          )
        }
      </ol>
    </div>

    <div class="block card">
      <h3 class="sub">Open source</h3>
      <p class="intro">Outside LeapView, I send fixes upstream to projects I use and help run open-source programs for students.</p>
      <ul class="list">
        {
          upstream.map((pr) => (
            <li>
              <span class="repo">
                {pr.repo}, {monthYear(pr.merged)}
              </span>
              <a href={pr.url}>{plainTitle(pr.title)}</a>
            </li>
          ))
        }
        {
          community.map((item) => (
            <li>
              <span class="repo">{item.period}</span>
              <strong>{item.title}</strong>
              {item.body && <span class="body">{item.body}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div class="block card">
      <h3 class="sub">Research</h3>
      <ul class="list">
        {
          papers.map((paper) => (
            <li>
              <span class="paper-title">{paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}</span>
              {paper.authors && (
                <span class="byline">
                  <strong class="me">{paper.authors[0]}</strong>{paper.authors.length > 1 && `, ${paper.authors.slice(1).join(', ')}`}
                </span>
              )}
              <span class="byline">{[paper.venue, paper.year].filter(Boolean).join(', ')}</span>
            </li>
          ))
        }
      </ul>

      <details class="disclosure recognition">
        <summary>
          <span class="rec-title">Awards and certifications</span>
          <span class="count">
            {plural(awards.length, 'award', 'awards')}, {plural(certifications.length, 'certification', 'certifications')}
          </span>
        </summary>
        <div class="columns">
          <ul class="plain" aria-label="Awards">
            {
              awards.map((award) => (
                <li>
                  {award.title}
                  <span class="by">
                    {award.by}, {award.year}
                  </span>
                </li>
              ))
            }
          </ul>
          <ul class="plain" aria-label="Certifications">
            {
              certifications.map((cert) => (
                <li>
                  {cert.title}
                  {(cert.by || cert.year) && <span class="by">{[cert.by, cert.year].filter(Boolean).join(', ')}</span>}
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      <p class="languages">I speak {person.languages.slice(0, -1).join(', ')} and {person.languages.at(-1)}.</p>
    </div>
  </div>
</section>

<style>
  .layout {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .experience {
      grid-column: 1 / -1;
    }
  }

  .block {
    padding: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-sm);
  }

  .sub {
    margin-bottom: 1rem;
    font-size: var(--step-2);
    font-weight: 750;
  }

  .roles > li,
  .list > li {
    border-top: 1px solid var(--line);
  }

  /* A role is a period beside what and where; the same grid works in a row or a summary. */
  .role,
  .role-details > summary {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 1.1rem;
  }

  .role-details > summary {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .role-details > summary::after {
    grid-column: 2;
    grid-row: 1;
  }

  @media (min-width: 44rem) {
    .role,
    .role-details > summary {
      grid-template-columns: 10rem minmax(0, 1fr) auto;
    }

    .role-details > summary::after {
      grid-column: 3;
    }
  }

  .period {
    padding-top: 0.15rem;
    color: var(--stone);
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
  }

  .what {
    display: grid;
    gap: 0.1rem;
  }

  .title {
    font-weight: 700;
  }

  .role-details > summary:hover .title {
    color: var(--lamp);
  }

  .org,
  .note {
    color: var(--stone);
  }

  .kind {
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.78rem;
    vertical-align: 0.1em;
  }

  .points {
    padding: 0 0 1.25rem 1.1rem;
    list-style: disc;
    max-width: var(--measure);
    color: var(--stone);
  }

  @media (min-width: 44rem) {
    .points {
      margin-left: 12rem;
    }
  }

  .points li + li {
    margin-top: 0.35rem;
  }

  .intro {
    margin-bottom: 1rem;
    color: var(--stone);
  }

  .list > li {
    display: grid;
    gap: 0.2rem;
    padding-block: 0.95rem;
  }

  .repo {
    color: var(--stone);
    font-size: 0.85rem;
  }

  .list strong {
    font-weight: 650;
  }

  .body,
  .byline {
    color: var(--stone);
  }

  .byline {
    font-size: var(--step--1);
  }

  .paper-title {
    font-weight: 650;
    line-height: 1.4;
  }

  .paper-title a {
    color: var(--plaster);
  }

  .paper-title a:hover {
    color: var(--lamp);
  }

  .me {
    color: var(--plaster);
  }

  .recognition {
    border-top: 1px solid var(--line);
  }

  .recognition > summary {
    flex-wrap: wrap;
    padding-block: 1rem;
  }

  .rec-title {
    font-weight: 700;
  }

  .recognition > summary:hover .rec-title {
    color: var(--lamp);
  }

  .count {
    color: var(--stone);
    font-size: var(--step--1);
  }

  .columns {
    display: grid;
    gap: 1.25rem 2rem;
    padding-block: 0.25rem 1rem;
  }

  @media (min-width: 30rem) {
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }

  .plain li + li {
    margin-top: 0.6rem;
  }

  .by {
    display: block;
    color: var(--stone);
    font-size: var(--step--1);
  }

  .languages {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    color: var(--stone);
  }
</style>
