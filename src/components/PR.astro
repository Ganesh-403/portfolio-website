---
// A citation: links a claim to the pull request that backs it.
// `full` shows the title beside the number, as one link.
import type { PullRequest } from '../data/profile';

interface Props {
  pr: PullRequest;
  full?: boolean;
}

const { pr, full = false } = Astro.props;
const href = `https://github.com/${pr.repo}/pull/${pr.number}`;
---

{
  full ? (
    <a class="line" href={href}>
      <span class="pr">#{pr.number}</span> <span class="title">{pr.title}</span>
    </a>
  ) : (
    /* The accessible name starts with the visible text so voice control ("click #800") works. */
    <a class="pr" href={href} title={pr.title} aria-label={`#${pr.number}: ${pr.title}`}>
      #{pr.number}
    </a>
  )
}

<style>
  .pr {
    display: inline-block;
    min-height: 24px; /* WCAG 2.5.8 minimum target size */
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  a.pr:hover,
  .line:hover .pr {
    border-color: var(--accent);
    color: var(--accent);
  }

  .line {
    display: inline-flex;
    align-items: baseline;
    gap: 0.75rem;
    color: var(--graphite);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .line .pr {
    flex: none;
  }

  .line:hover .title {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
