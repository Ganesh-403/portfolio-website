---
// A citation: links a claim to the pull request that backs it.
import type { PullRequest } from '../data/profile';

interface Props {
  pr: PullRequest;
}

const { pr } = Astro.props;
const href = `https://github.com/${pr.repo}/pull/${pr.number}`;
---

<!-- The accessible name starts with the visible text so voice control ("click #800") works. -->
<a class="pr" href={href} title={pr.title} aria-label={`#${pr.number}: ${pr.title}`}>#{pr.number}</a>

<style>
  .pr {
    display: inline-block;
    min-height: 24px; /* WCAG 2.5.8 minimum target size */
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }

  .pr:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
