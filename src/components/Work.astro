---
import MetricCard from './MetricCard.astro';
import PR from './PR.astro';
import { leapview } from '../data/profile';

const slug = (title: string) => title.toLowerCase().replace(/[^a-z0-9]+/g, '-');
---

<section class="section" id="work" aria-labelledby="work-name">
  <h2 class="section-name" id="work-name">Now, at Flid AI</h2>

  <div class="feature card">
    <div class="about">
      <h3 class="title"><a href={leapview.url}>{leapview.name}</a></h3>
      <p class="tagline">{leapview.tagline}</p>
      <p class="summary">{leapview.summary}</p>
      <p class="focus">{leapview.focus}</p>

      {/* Areas: one at a time once the script turns the list into tabs; without it, all of them show. */}
      <div class="areas" data-tabs>
        <div class="tablist" role="tablist" aria-label="Areas I work on" hidden>
          {
            leapview.areas.map((area, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${slug(area.title)}`}
                aria-controls={`area-${slug(area.title)}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                {area.title}
              </button>
            ))
          }
        </div>
        {
          leapview.areas.map((area) => (
            <div class="panel" id={`area-${slug(area.title)}`} data-tab={`tab-${slug(area.title)}`}>
              <h4 class="panel-title">{area.title}</h4>
              <p>{area.body}</p>
              <ul class="prs" aria-label={`Pull requests for ${area.title.toLowerCase()}`}>
                {area.prs.map((pr) => (
                  <li>
                    <PR pr={pr} full />
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <div class="numbers-side">
      <MetricCard />
    </div>
  </div>

  <p class="links">
    <a href={leapview.url}>LeapView on GitHub</a>
    <a href={leapview.site}>leapview.dev</a>
    <a href={`https://github.com/flidai/leapview/pulls?q=is%3Apr+is%3Amerged+author%3AGanesh-403`}>All my merged pull requests</a>
  </p>
  <p class="also">
    I also work on <a href={leapview.alsoAt.url}>{leapview.alsoAt.name}</a>, {leapview.alsoAt.body}
  </p>
</section>

<script>
  // WAI-ARIA tabs: arrow keys, Home and End move between areas; the panel follows the selected tab.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const list = root.querySelector<HTMLElement>('[role="tablist"]');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>('.panel')];
    if (!list || !tabs.length || tabs.length !== panels.length) return;
    // Panels only become tab panels once the tabs exist.
    panels.forEach((panel) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', panel.dataset.tab ?? '');
    });

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    list.hidden = false;
    root.classList.add('tabbed');
    select(0);
    tabs.forEach((tab, i) => tab.addEventListener('click', () => select(i)));
    list.addEventListener('keydown', (event) => {
      const current = tabs.findIndex((tab) => tab.getAttribute('aria-selected') === 'true');
      const next = { ArrowRight: current + 1, ArrowDown: current + 1, ArrowLeft: current - 1, ArrowUp: current - 1, Home: 0, End: tabs.length - 1 }[event.key];
      if (next === undefined) return;
      event.preventDefault();
      select((next + tabs.length) % tabs.length, true);
    });
  });
</script>

<style>
  /* clip, not hidden: a hidden overflow would make the card a scroll container, and the chart's
     scroll-driven animation would then track the card instead of the page. */
  .feature {
    display: grid;
    overflow: clip;
  }

  @media (min-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }

  .about,
  .numbers-side {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
  }

  .numbers-side {
    border-top: 1px solid var(--line);
  }

  @media (min-width: 60rem) {
    .numbers-side {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  .title {
    font-size: var(--step-4);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .title a {
    color: var(--plaster);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--lamp);
  }

  .tagline {
    margin-top: 0.75rem;
    color: var(--stone);
    font-size: var(--step-1);
  }

  .summary {
    max-width: var(--measure);
    margin-top: 1.5rem;
    color: var(--stone);
  }

  .focus {
    max-width: var(--measure);
    margin-top: 0.75rem;
  }

  .areas {
    margin-top: 2rem;
  }

  .tablist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tablist[hidden] {
    display: none;
  }

  [role='tab'] {
    min-height: 2.5rem;
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--plaster);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
  }

  [role='tab']:hover {
    border-color: var(--stone);
  }

  [role='tab'][aria-selected='true'] {
    border-color: var(--lamp);
    background: var(--lamp);
    color: var(--on-lamp);
    font-weight: 650;
  }

  @media (prefers-reduced-motion: no-preference) {
    [role='tab'] {
      transition:
        background-color 200ms,
        border-color 200ms,
        color 200ms;
    }
  }

  /* Without the script every area shows, each under its own heading. */
  .panel + .panel {
    margin-top: 1.5rem;
  }

  .panel-title {
    margin-bottom: 0.4rem;
    font-size: var(--step-0);
    font-weight: 700;
  }

  .tabbed .panel {
    margin-top: 1.25rem;
  }

  .tabbed .panel-title {
    display: none;
  }

  .panel p {
    max-width: var(--measure);
    color: var(--stone);
  }

  /* A newly selected panel fades in. */
  @media (prefers-reduced-motion: no-preference) {
    .tabbed .panel:not([hidden]) {
      transition: opacity 250ms var(--ease-out);

      @starting-style {
        opacity: 0;
      }
    }
  }

  .prs {
    display: grid;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin-top: 1.75rem;
  }

  .also {
    margin-top: 1rem;
    color: var(--stone);
  }
</style>
