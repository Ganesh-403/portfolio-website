---
import MetricCard from './MetricCard.astro';
import PR from './PR.astro';
import { leapview } from '../data/profile';
---

<section class="section" id="work" aria-labelledby="work-name">
  <h2 class="section-name" id="work-name">Work at Flid AI</h2>
  <div class="section-body">
    <h3 class="title">
      <a href={leapview.url}>{leapview.name}</a>
    </h3>
    <p class="tagline">{leapview.tagline}</p>
    <p class="summary">{leapview.summary}</p>

    <div class="metric-wrap">
      <MetricCard />
    </div>

    <h4 class="areas-title">Where my changes go</h4>
    <ul class="areas">
      {
        leapview.areas.map((area) => (
          <li>
            <details class="disclosure area">
              {/* What I did stays visible; the pull requests behind it open on request. */}
              <summary>
                <span class="area-text">
                  <span class="area-name">{area.title}</span>
                  <span class="area-desc">{area.body}</span>
                </span>
              </summary>
              <div class="area-body">
                <ul class="prs" aria-label={`Pull requests for ${area.title.toLowerCase()}`}>
                  {area.prs.map((pr) => (
                    <li>
                      <PR pr={pr} full />
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          </li>
        ))
      }
    </ul>

    <p class="links">
      <a href={leapview.url}>LeapView on GitHub</a>
      <a href={leapview.site}>leapview.dev</a>
      <a href={`https://github.com/flidai/leapview/pulls?q=is%3Apr+is%3Amerged+author%3AGanesh-403`}>All my merged pull requests</a>
    </p>

    <p class="also">
      I also work on <a href={leapview.alsoAt.url}>{leapview.alsoAt.name}</a>, {leapview.alsoAt.body}
    </p>
  </div>
</section>

<style>
  .title {
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .title a {
    color: var(--ink);
    text-decoration: none;
  }

  .title a:hover {
    text-decoration: underline;
  }

  .tagline {
    margin-top: 0.4rem;
    font-size: var(--step-1);
    color: var(--graphite);
  }

  .summary {
    margin-top: 1.5rem;
    max-width: var(--measure);
  }

  .metric-wrap {
    margin-top: 2rem;
  }

  .areas-title {
    margin-top: 3rem;
    font-size: var(--step-1);
  }

  .areas {
    margin-top: 1rem;
    border-top: 1px solid var(--rule);
  }

  .areas > li {
    border-bottom: 1px solid var(--rule);
  }

  .area > summary {
    padding-block: 1.1rem;
  }

  .area-text {
    display: grid;
    gap: 0.2rem 2rem;
    max-width: var(--measure);
  }

  @media (min-width: 44rem) {
    .area-text {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }

  .area-name {
    font-weight: 700;
  }

  .area-desc {
    color: var(--graphite);
  }

  .area > summary:hover .area-name {
    color: var(--accent);
  }

  /* Top padding keeps the first link's focus ring inside the clipped, animating panel. */
  .area-body {
    padding-block: 0.4rem 1.25rem;
  }

  @media (min-width: 44rem) {
    .area-body {
      padding-left: 13rem;
    }
  }

  .prs {
    display: grid;
    gap: 0.5rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.75rem;
  }

  .also {
    margin-top: 1.75rem;
    color: var(--graphite);
  }
</style>
