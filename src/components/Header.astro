---
import { person } from '../data/profile';

const initials = person.name
  .split(' ')
  .map((part) => part[0])
  .join('');

// Root-relative so the links also work from the 404 page.
const nav = [
  { href: '/#work', label: 'Work' },
  { href: '/#projects', label: 'Projects' },
  { href: '/#freelance', label: 'Freelance' },
  { href: '/#background', label: 'Background' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="page bar">
    <a class="home" href="/">{initials}<span class="visually-hidden"> {person.name}, home</span></a>
    <nav aria-label="Sections">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <button class="find" type="button" data-palette-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.5 4.5"></path></svg>
      <span class="visually-hidden">Search and commands</span>
      <kbd data-keys>Ctrl K</kbd>
    </button>
    <button class="theme-switch" type="button" data-theme-switch aria-pressed="false">
      <span class="visually-hidden">Dark mode</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <mask id="theme-moon">
          <rect width="24" height="24" fill="white" />
          <circle class="bite" cx="24" cy="4" r="7" fill="black" />
        </mask>
        <circle class="disc" cx="12" cy="12" r="5" mask="url(#theme-moon)" />
        <g class="rays">
          <path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8" />
        </g>
      </svg>
    </button>
  </div>
</header>

<script>
  import { themeSwitch } from '../scripts/theme';
  themeSwitch();

  // The palette's shortcut, written the way this keyboard says it.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-keys]').forEach((kbd) => (kbd.textContent = '⌘K'));
  }

  // On phones the nav scrolls sideways; keep a focused link fully in view.
  document.querySelector('nav')?.addEventListener('focusin', (event) => {
    (event.target as HTMLElement).scrollIntoView({ block: 'nearest', inline: 'nearest' });
  });

  // Marks the section being read in the nav, so the header doubles as a map of the page.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('nav a[href^="/#"]')].map((a) => [a.hash.slice(1), a]),
  );
  // The hero has no nav link; reaching it clears the marker.
  const sections = [...links.keys(), 'top'].map((id) => document.getElementById(id)).filter((el) => el !== null);
  if (sections.length && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(entry.target.id)?.setAttribute('aria-current', 'true');
        }
      },
      // A thin band across the middle of the viewport decides which section is current.
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
  }

  /* The paper tint, blur and rule live on their own layer so they fade in together: at the top
     of the page the header sits straight on the paper, like a masthead. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    /* Unprefixed only: given both, the minifier keeps just the -webkit- copy, which Chromium
       ignores. Current Safari supports the unprefixed property. */
    backdrop-filter: blur(14px);
  }

  /* At the top of the page the header is clear; the layer fades in over the first stretch of
     scrolling. Without scroll-driven animations it is always on. */
  @supports (animation-timeline: scroll()) {
    .site-header::before {
      animation: tint linear both;
    }

    /* A separate rule: the minifier would otherwise fold the timeline into the animation
       shorthand, which browsers reject. */
    header.site-header::before {
      animation-timeline: scroll(root);
      animation-range: 0 8rem;
    }

    @keyframes tint {
      from {
        opacity: 0;
      }
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
    min-height: 4.5rem;
  }

  .home {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-style: italic;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .home:hover {
    color: var(--accent);
  }

  /* Sun in the light edition, moon in the dark: the disc grows, a bite slides in, the rays fold. */
  .theme-switch {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--glass-line);
    border-radius: 50%;
    background: var(--glass);
    color: var(--fg);
    cursor: pointer;
  }

  .theme-switch:hover,
  .find:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* Opens the command palette; the keys are shown where there is room for them. */
  .find {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 0.9rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass);
    color: var(--fg);
    font: inherit;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .find svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  .find kbd {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  @media (max-width: 48rem) {
    .find kbd {
      display: none;
    }
  }

  .theme-switch svg {
    width: 1.35rem;
    height: 1.35rem;
    overflow: visible;
  }

  .disc {
    fill: currentColor;
  }

  .rays {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-width: 1.8;
    transform-origin: 12px 12px;
  }

  [aria-pressed='true'] .disc {
    r: 8.5px;
  }

  [aria-pressed='true'] .bite {
    cx: 16px;
    cy: 7px;
  }

  [aria-pressed='true'] .rays {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  @media (prefers-reduced-motion: no-preference) {
    .disc,
    .bite,
    .rays {
      transition:
        r 500ms var(--ease-out),
        cx 500ms var(--ease-out),
        cy 500ms var(--ease-out),
        opacity 400ms,
        transform 500ms var(--ease-out);
    }
  }

  nav {
    margin-left: auto;
    min-width: 0;
    overflow-x: auto;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
  }

  /* The padding leaves room for focus rings, which the scrolling nav would otherwise clip. */
  nav ul {
    display: flex;
    gap: 1.75rem;
    width: max-content;
    padding: 0.35rem;
  }

  nav a {
    position: relative;
    display: inline-block;
    padding-block: 0.5rem;
    color: var(--muted);
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
  }

  nav a:hover,
  nav a[aria-current] {
    color: var(--fg);
  }

  /* The current section's link gets an underline that grows in from the left. */
  nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0.15rem;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }

  nav a[aria-current]::after {
    transform: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    nav a::after {
      transition: transform 300ms var(--ease-out);
    }
  }

  /* On phones the section links sit beside the mark in one scrollable row. */
  @media (max-width: 40rem) {
    .bar {
      gap: 0.75rem;
      min-height: 3.75rem;
    }

    nav {
      margin-right: calc(var(--gutter) * -1);
      padding-right: calc(var(--gutter) - 0.35rem);
    }

    nav ul {
      gap: 1rem;
    }

    nav a {
      font-size: 0.88rem;
    }
  }
</style>
