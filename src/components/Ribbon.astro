---
import { projects } from '../data/profile';

// Two crossing bands of type, tilted back in space, carrying the tools from the projects above
// and below. Decorative: every tool here is also listed in its project's "How it works".
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;

const tools = [...new Set(['Go', 'DuckDB', ...projects.flatMap((p) => p.stack)])];
const half = Math.ceil(tools.length / 2);
const bands = flip ? [tools.slice(half), tools.slice(0, half)] : [tools.slice(0, half), tools.slice(half)];
---

<div class:list={['ribbons', { flip }]} aria-hidden="true">
  {
    bands.map((band, i) => (
      <div class:list={['band', i ? 'ink' : 'red']}>
        <div class="track">
          {[0, 1, 2].map(() => (
            <span class="run">
              {band.map((tool) => (
                <span class="tool">
                  {tool}
                  <i>✶</i>
                </span>
              ))}
            </span>
          ))}
        </div>
      </div>
    ))
  }
</div>

<style>
  /* Full-bleed: wider than the page column, clipped by the body. */
  .ribbons {
    position: relative;
    display: grid;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
    perspective: 50rem;
    overflow: clip;
  }

  .band {
    grid-area: 1 / 1;
    width: 112%;
    margin-left: -6%;
    padding-block: 0.7rem;
    border-block: 1px solid var(--ink);
    overflow: hidden;
    white-space: nowrap;
    transform-style: preserve-3d;
  }

  .red {
    z-index: 1;
    background: var(--accent);
    color: var(--on-accent);
    transform: rotateX(18deg) rotateZ(-3deg) translateZ(1rem);
    box-shadow: 0 1.2rem 1.5rem -0.8rem var(--haze);
  }

  .ink {
    background: var(--ink);
    color: var(--paper);
    transform: rotateX(-14deg) rotateZ(2.5deg) translateZ(-2rem);
  }

  .flip .red {
    transform: rotateX(-16deg) rotateZ(2.5deg) translateZ(1rem);
  }

  .flip .ink {
    transform: rotateX(16deg) rotateZ(-3deg) translateZ(-2rem);
  }

  .track {
    display: flex;
    width: max-content;
  }

  .run {
    display: flex;
    flex: none;
  }

  .tool {
    display: inline-flex;
    align-items: center;
    gap: 1.4rem;
    padding-right: 1.4rem;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.6vw, 2.4rem);
    font-style: italic;
    font-weight: 600;
    line-height: 1.1;
  }

  .tool i {
    font-style: normal;
    font-size: 0.7em;
    opacity: 0.8;
  }

  .ink .tool {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 0.8rem + 0.8vw, 1.4rem);
    font-style: normal;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The bands run in opposite directions; three copies of the run keep the loop seamless on wide screens. */
  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: run 38s linear infinite;
    }

    .ink .track {
      animation-direction: reverse;
      animation-duration: 46s;
    }
  }

  @keyframes run {
    to {
      transform: translateX(-33.333%);
    }
  }
</style>
