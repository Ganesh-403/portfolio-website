---
import PR from './PR.astro';
import { person, offers, contact } from '../data/profile';
---

<section class="section" id="contact" aria-labelledby="contact-name">
  <h2 class="section-name" id="contact-name">Work with me</h2>
  <div class="section-body">
    <p class="lede">
      I take on freelance and contract work alongside my role at Flid AI. These are the kinds of problems I'm best placed
      to help with.
    </p>

    <ul class="offers">
      {
        offers.map((offer) => (
          <li>
            <h3>{offer.title}</h3>
            <p>{offer.body}</p>
            <p class="proof muted">
              Related work:{' '}
              {offer.proof.map((pr) => (
                <PR pr={pr} />
              ))}
              {offer.projects?.map((name) => (
                <a href="#projects">{name}</a>
              ))}
            </p>
          </li>
        ))
      }
    </ul>

    <div class="reach">
      <div class="direct">
        <h3>Get in touch</h3>
        <p>Tell me what you're building and where you're stuck. Email works best:</p>
        <p class="email"><a href={`mailto:${person.email}`}>{person.email}</a></p>
        <ul class="elsewhere">
          <li><a href={person.links.linkedin}>LinkedIn</a></li>
          <li><a href={person.links.github}>GitHub</a></li>
          <li><a href={person.links.sponsors}>GitHub Sponsors</a></li>
        </ul>
      </div>

      <form class="form" action={contact.formEndpoint} method="POST" data-contact-form>
        <h3 class="visually-hidden">Send a message</h3>
        <label>
          <span>Name</span>
          <input name="name" type="text" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input name="email" type="email" autocomplete="email" required />
        </label>
        <label>
          <span>What are you working on?</span>
          <textarea name="message" rows="5" required></textarea>
        </label>
        <!-- Formspree drops submissions that fill this hidden field. -->
        <input class="trap" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button primary" type="submit">Send message</button>
        <p class="status" role="status" aria-live="polite" data-status></p>
      </form>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: without JS the form posts to Formspree and shows its own page.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const button = form?.querySelector<HTMLButtonElement>('button[type="submit"]');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!status || !button) return;
    button.disabled = true;
    status.dataset.state = '';
    status.textContent = 'Sending…';
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.dataset.state = 'sent';
      status.textContent = 'Message sent. I’ll reply by email.';
    } catch {
      status.dataset.state = 'error';
      status.textContent = 'The message didn’t send. Please try again, or email me directly.';
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .offers {
    display: grid;
    gap: 1.75rem;
    margin-top: 2.25rem;
  }

  .offers li {
    padding-left: 1.1rem;
    border-left: 2px solid var(--signal);
  }

  .offers h3 {
    font-size: var(--step-1);
    margin-bottom: 0.35rem;
  }

  .offers p {
    max-width: var(--measure);
  }

  .proof {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.5rem;
    margin-top: 0.6rem;
    font-size: var(--step--1);
  }

  .reach {
    display: grid;
    gap: 2.5rem;
    margin-top: 3.5rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--rule);
    border-radius: calc(var(--radius) + 4px);
    background: var(--raised);
  }

  @media (min-width: 52rem) {
    .reach {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .direct h3 {
    font-size: var(--step-1);
    margin-bottom: 0.5rem;
  }

  .email {
    margin-top: 0.75rem;
    font-size: var(--step-1);
    font-weight: 650;
    overflow-wrap: anywhere;
  }

  .elsewhere {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }

  .form {
    display: grid;
    gap: 1rem;
  }

  label {
    display: grid;
    gap: 0.35rem;
    font-size: var(--step--1);
    font-weight: 650;
  }

  input,
  textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    font: inherit;
    font-weight: 400;
    font-size: var(--step-0);
  }

  input:hover,
  textarea:hover {
    border-color: var(--graphite);
  }

  input:focus-visible,
  textarea:focus-visible {
    outline-offset: 0;
    border-color: var(--signal);
  }

  textarea {
    resize: vertical;
    min-height: 8rem;
  }

  .trap {
    position: absolute;
    left: -100vw;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .form .button {
    justify-self: start;
  }

  .form .button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .status {
    min-height: 1.6em;
    font-size: var(--step--1);
    color: var(--graphite);
  }

  .status[data-state='sent'] {
    color: var(--ink);
    font-weight: 650;
  }

  .status[data-state='error'] {
    color: var(--accent);
    font-weight: 650;
  }
</style>
