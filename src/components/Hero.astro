---
import { Image, getImage } from 'astro:assets';
import photo from '../assets/ganesh.jpg';
import { person, hero, leapview } from '../data/profile';
import { monthYear } from '../lib/format';

// Scanning order: the name, the one-line offer, the actions, then the proof. The photo sits beside
// them on wide screens and after the actions on phones, so "Work with me" is on the first screen.
const [first, ...rest] = person.name.split(' ');
const last = rest.join(' ');
const { mergedPRs, firstMerged } = leapview.stats;

// A sparkline of the same weeks the Work chart shows; the full, explorable chart lives there.
const weekly = leapview.stats.weekly.slice(-12);
const max = Math.max(...weekly.map((w) => w.merged), 1);

// The 3D stage prints the photo onto a card, so it needs one plain texture of it.
const texture = await getImage({ src: photo, width: 1024, format: 'webp' });
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <figure class="portrait" data-stage data-texture={texture.src} data-weeks={JSON.stringify(leapview.stats.weekly.map((w) => w.merged))}>
    <div class="frame">
      <Image
        src={photo}
        alt={`${person.name} leaning on a balcony railing at night`}
        widths={[400, 600, 700, 800]}
        format="avif"
        sizes="(min-width: 60rem) 36rem, calc(100vw - 2.25rem)"
        loading="eager"
      fetchpriority="high"
      />
      <canvas aria-hidden="true"></canvas>
    </div>
    <figcaption>
      <span>{person.location}</span>
      <span class="time" data-local-time>{person.timezone}</span>
    </figcaption>
  </figure>

  <div class="text">
    <h1 id="hero-name">
      <span class="visually-hidden">{person.name}</span>
      <span class="word" aria-hidden="true">
        {[...first].map((char, i) => <span class="char" style={`--i:${i}`}>{char}</span>)}
      </span>
      <span class="word last" aria-hidden="true">
        {[...last].map((char, i) => <span class="char" style={`--i:${i + first.length}`}>{char}</span>)}
      </span>
    </h1>
    <p class="role"><strong>{person.role}</strong> at <a href={person.companyUrl}>{person.company}</a></p>
    <p class="pitch">{hero.lede}</p>
    <div class="actions">
      <a class="button primary" href="#contact" data-magnet>Work with me</a>
      <a class="button" href={`mailto:${person.email}`} data-magnet>Email</a>
      <a class="button" href={person.links.github} data-magnet>GitHub</a>
      <a class="button" href={person.links.linkedin} data-magnet>LinkedIn</a>
    </div>
    <a class="proof" href="#work">
      <span class="spark" aria-hidden="true">
        {weekly.map((w, i) => <i style={`--h:${Math.max(4, (w.merged / max) * 100)}%;--i:${i}`} />)}
      </span>
      <span class="proof-text">
        <strong>{mergedPRs}</strong>
        merged pull requests in LeapView since {firstMerged ? monthYear(firstMerged) : leapview.joined}
      </span>
    </a>
  </div>
</section>

<script>
  // Shows the time in Mumbai, so people abroad know whether I'm likely to reply soon.
  const el = document.querySelector<HTMLElement>('[data-local-time]');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });
    const tick = () => (el.textContent = `${format.format(new Date())} here`);
    tick();
    setInterval(tick, 30_000);
  }

  // The 3D stage loads after the page is idle, so the photo is the first paint and Three.js never
  // delays it. On a phone saving data, or without WebGL, the flat photo stays.
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (stage && !saveData) {
    const load = () => import('../scripts/stage').then(({ mountStage }) => mountStage(stage));
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 2000 });
    else setTimeout(load, 300);
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: clamp(3rem, 1rem + 4vw, 5rem);
      align-items: center;
    }
  }

  /* Phones read the text first; the photo follows the actions. */
  .portrait {
    order: 1;
    max-width: 36rem;
  }

  @media (min-width: 60rem) {
    .portrait {
      order: 0;
    }
  }

  /* A printed photograph: a hairline frame and a solid ink block offset behind it. */
  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper-deep);
    box-shadow: 0.75rem 0.75rem 0 var(--ink);
  }

  /* The 3D stage draws over the photo and bleeds past it, so the blocks and shadows have room.
     The photo stays underneath for screen readers and as the fallback. */
  .frame {
    position: relative;
  }

  canvas {
    position: absolute;
    inset: -8% -5% -6%;
    width: 110%;
    height: 114%;
    pointer-events: none;
    opacity: 0;
    /* Shadows fade out before the canvas edge instead of stopping at it. */
    mask-image: linear-gradient(to right, #000 82%, transparent), linear-gradient(to bottom, #000 88%, transparent);
    mask-composite: intersect;
  }

  @media (min-width: 60rem) {
    canvas {
      inset: -12% -14% -8% -10%;
      width: 124%;
      height: 120%;
    }
  }

  .is-3d canvas {
    opacity: 1;
  }

  .is-3d img {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    canvas,
    .portrait img {
      transition: opacity 600ms var(--ease-out);
    }
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.6rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--rule);
    color: var(--graphite);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .time {
    color: var(--accent);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.035em;
  }

  /* Each letter is its own block of type: they flip up into place on load, and lift when the
     pointer passes over them. */
  .word {
    display: block;
    perspective: 40rem;
  }

  .char {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .char {
      animation: flip 700ms var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 40ms);
      transition: transform 350ms var(--ease-out);
    }

    .char:hover {
      transform: translateY(-0.1em) rotate(-5deg) scale(1.06);
    }
  }

  @keyframes flip {
    from {
      opacity: 0;
      transform: translateY(0.25em) rotateX(-100deg);
    }
  }

  /* The surname in italic vermilion, the one flourish on the page, set like metal type: it stands
     off the page on a block of ink, one pixel per layer. */
  .last {
    color: var(--accent);
    font-style: italic;
    font-weight: 600;
    text-shadow:
      1px 1px 0 var(--ink),
      2px 2px 0 var(--ink),
      3px 3px 0 var(--ink),
      4px 4px 0 var(--ink),
      5px 5px 0 var(--ink),
      6px 6px 0 var(--ink),
      7px 7px 14px rgb(27 25 22 / 0.25);
  }

  .role {
    margin-top: 1.4rem;
    color: var(--graphite);
    font-size: var(--step-1);
  }

  .role strong {
    color: var(--ink);
    font-weight: 650;
  }

  .role a {
    color: var(--graphite);
  }

  .role a:hover {
    color: var(--accent);
  }

  .pitch {
    max-width: 26ch;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 500;
    line-height: 1.22;
    letter-spacing: -0.01em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* Where the text column is narrowest, tighter buttons keep all four on one row. */
  @media (min-width: 60rem) and (max-width: 72rem) {
    .actions {
      gap: 0.5rem;
    }

    .actions .button {
      padding-inline: 1rem;
    }
  }

  /* On phones the primary action takes its own row so the other three fit on one line. */
  @media (max-width: 30rem) {
    .actions .primary {
      flex-basis: 100%;
    }

    .actions .button:not(.primary) {
      flex: 1 1 0;
      padding-inline: 0.5rem;
    }
  }

  .proof {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--ink);
    color: var(--graphite);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .proof:hover .proof-text {
    color: var(--ink);
  }

  .spark {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 4px;
    height: 2.75rem;
  }

  .spark i {
    width: 8px;
    height: var(--h);
    background: var(--ink);
    transform-origin: bottom;
  }

  .proof-text strong {
    display: block;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  /* The page's one orchestrated moment: the photo opens out, the lines under the name rise in
     one after another, and the sparkline draws in. The name itself never waits. */
  @media (prefers-reduced-motion: no-preference) {
    /* backwards, not both: holding the last frame's clip-path would also clip the offset block. */
    .portrait img {
      animation: open 1000ms var(--ease-out) backwards;
    }

    .role,
    .pitch,
    .actions,
    .proof {
      animation: rise 600ms var(--ease-out) both;
    }

    .role {
      animation-delay: 100ms;
    }

    .pitch {
      animation-delay: 200ms;
    }

    .actions {
      animation-delay: 300ms;
    }

    .proof {
      animation-delay: 400ms;
    }

    .spark i {
      animation: grow 600ms var(--ease-out) both;
      animation-delay: calc(550ms + var(--i) * 45ms);
    }
  }

  @keyframes open {
    from {
      clip-path: inset(7% 7% 7% 7%);
      transform: scale(1.04);
    }
    to {
      clip-path: inset(0 -1rem -1rem 0);
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
