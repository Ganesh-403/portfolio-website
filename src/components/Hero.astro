---
import { Image } from 'astro:assets';
import photo from '../assets/ganesh.jpg';
import { person, hero, leapview } from '../data/profile';
import { monthYear } from '../lib/format';

// Scanning order: the name, the one-line offer, the actions, then the proof. The photo sits beside
// them on wide screens and after the actions on phones, so "Work with me" is on the first screen.
const [first, ...rest] = person.name.split(' ');
const { mergedPRs, firstMerged } = leapview.stats;

// A sparkline of the same weeks the Work chart shows; the full, explorable chart lives there.
const weekly = leapview.stats.weekly.slice(-12);
const max = Math.max(...weekly.map((w) => w.merged), 1);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <figure class="portrait">
    <Image
      src={photo}
      alt={`${person.name} leaning on a balcony railing at night`}
      widths={[400, 600, 700, 800]}
      format="avif"
      sizes="(min-width: 60rem) 36rem, calc(100vw - 2.25rem)"
      loading="eager"
      fetchpriority="high"
    />
    <figcaption>
      <span>{person.location}</span>
      <span class="time" data-local-time>{person.timezone}</span>
    </figcaption>
  </figure>

  <div class="text">
    <h1 id="hero-name"><span>{first}</span> <span class="last">{rest.join(' ')}</span></h1>
    <p class="role"><strong>{person.role}</strong> at <a href={person.companyUrl}>{person.company}</a></p>
    <p class="pitch">{hero.lede}</p>
    <div class="actions">
      <a class="button primary" href="#contact">Work with me</a>
      <a class="button" href={`mailto:${person.email}`}>Email</a>
      <a class="button" href={person.links.github}>GitHub</a>
      <a class="button" href={person.links.linkedin}>LinkedIn</a>
    </div>
    <a class="proof" href="#work">
      <span class="spark" aria-hidden="true">
        {weekly.map((w, i) => <i style={`--h:${Math.max(4, (w.merged / max) * 100)}%;--i:${i}`} />)}
      </span>
      <span class="proof-text">
        <strong>{mergedPRs}</strong>
        merged pull requests in LeapView since {firstMerged ? monthYear(firstMerged) : leapview.joined}
      </span>
    </a>
  </div>
</section>

<script>
  // Shows the time in Mumbai, so people abroad know whether I'm likely to reply soon.
  const el = document.querySelector<HTMLElement>('[data-local-time]');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });
    const tick = () => (el.textContent = `${format.format(new Date())} here`);
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
      gap: clamp(3rem, 1rem + 4vw, 5rem);
      align-items: center;
    }
  }

  /* Phones read the text first; the photo follows the actions. */
  .portrait {
    order: 1;
    max-width: 36rem;
  }

  @media (min-width: 60rem) {
    .portrait {
      order: 0;
    }
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius);
    background: var(--raised);
    box-shadow: 0 2.5rem 7.5rem -2rem rgb(243 195 124 / 0.32);
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
    color: var(--stone);
    font-size: var(--step--1);
  }

  .time {
    color: var(--lamp);
  }

  h1 {
    font-size: var(--step-5);
    font-weight: 800;
    line-height: 0.86;
    letter-spacing: -0.05em;
  }

  h1 span {
    display: block;
  }

  .last {
    color: var(--lamp);
  }

  .role {
    margin-top: 1.4rem;
    color: var(--stone);
    font-size: var(--step-1);
  }

  .role strong {
    color: var(--plaster);
    font-weight: 650;
  }

  .role a {
    color: var(--stone);
  }

  .role a:hover {
    color: var(--lamp);
  }

  .pitch {
    max-width: 26ch;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 1.1rem + 1.2vw, 2rem);
    font-weight: 650;
    line-height: 1.22;
    letter-spacing: -0.015em;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* On phones the primary action takes its own row so the other three fit on one line. */
  @media (max-width: 30rem) {
    .actions .primary {
      flex-basis: 100%;
    }

    .actions .button:not(.primary) {
      flex: 1 1 0;
      padding-inline: 0.5rem;
    }
  }

  .proof {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    color: var(--stone);
    font-size: var(--step--1);
    text-decoration: none;
  }

  .proof:hover .proof-text {
    color: var(--plaster);
  }

  .spark {
    display: flex;
    flex: none;
    align-items: flex-end;
    gap: 4px;
    height: 2.75rem;
  }

  .spark i {
    width: 8px;
    height: var(--h);
    border-radius: 2px;
    background: var(--lamp);
    transform-origin: bottom;
  }

  .proof-text strong {
    display: block;
    color: var(--plaster);
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  /* The page's one orchestrated moment: the photo opens out, the lines under the name rise in
     one after another, and the sparkline draws in. The name itself never waits. */
  @media (prefers-reduced-motion: no-preference) {
    .portrait img {
      animation: open 1000ms var(--ease-out) both;
    }

    .role,
    .pitch,
    .actions,
    .proof {
      animation: rise 600ms var(--ease-out) both;
    }

    .role {
      animation-delay: 100ms;
    }

    .pitch {
      animation-delay: 200ms;
    }

    .actions {
      animation-delay: 300ms;
    }

    .proof {
      animation-delay: 400ms;
    }

    .spark i {
      animation: grow 600ms var(--ease-out) both;
      animation-delay: calc(550ms + var(--i) * 45ms);
    }
  }

  @keyframes open {
    from {
      clip-path: inset(7% 7% 7% 7% round 40px);
      transform: scale(1.04);
    }
    to {
      clip-path: inset(0 0 0 0 round var(--radius));
      transform: none;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0);
    }
  }
</style>
