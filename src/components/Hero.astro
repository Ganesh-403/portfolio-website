---
import { Image } from 'astro:assets';
import photo from '../assets/ganesh.jpg';
import { person, hero, leapview } from '../data/profile';
import { monthYear } from '../lib/format';

// Scanning order: the name, who and where, the one-line offer, the actions. Beside them, the photo,
// large, with a ring of my merged pull requests turning slowly around it (scripts/galaxy.ts);
// the legend under the actions says what the points are.
const [first, ...rest] = person.name.split(' ');
const last = rest.join(' ');
const { mergedPRs, firstMerged } = leapview.stats;
const since = firstMerged ? monthYear(firstMerged) : leapview.joined;
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="text">
    <a class="status" href="#freelance"><span class="pulse" aria-hidden="true"></span>Taking on freelance projects</a>

    <h1 id="hero-name">
      <span class="visually-hidden">{person.name}</span>
      <span class="word" aria-hidden="true">
        {[...first].map((char, i) => <span class="char" style={`--i:${i}`}>{char}</span>)}
      </span>
      <span class="word last" aria-hidden="true">
        {[...last].map((char, i) => <span class="char" style={`--i:${i + first.length}`}>{char}</span>)}
      </span>
    </h1>

    <p class="role">
      <strong>{person.role}</strong> at <a href={person.companyUrl}>{person.company}</a>
      <span class="sep" aria-hidden="true">·</span>
      {person.location}
      <span class="sep" aria-hidden="true">·</span>
      <span class="time" data-local-time>{person.timezone}</span>
    </p>
    <p class="pitch">{hero.lede}</p>
    <div class="actions">
      <a class="button primary" href="#contact" data-magnet>Work with me</a>
      <a class="button" href={`mailto:${person.email}`} data-magnet>Email</a>
      <a class="button" href={person.links.github} data-magnet>GitHub</a>
      <a class="button" href={person.links.linkedin} data-magnet>LinkedIn</a>
    </div>
  </div>

  <div class="visual">
    <canvas class="galaxy back" aria-hidden="true" data-weeks={JSON.stringify(leapview.stats.weekly.map((w) => w.merged))}></canvas>
    <figure class="portrait card" data-tilt>
      <Image
        src={photo}
        alt={`${person.name} leaning on a balcony railing at night`}
        widths={[480, 640, 800]}
        format="webp"
        quality={92}
        sizes="(min-width: 64rem) 30rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>{person.name}</span>
        <span class="muted">{person.role}, {person.company}</span>
      </figcaption>
    </figure>
    <canvas class="galaxy front" aria-hidden="true"></canvas>
  </div>

  <p class="legend">
    <span class="swatch" aria-hidden="true"></span>
    <span>
      The ring of light around my photo is my <strong>{mergedPRs}</strong> merged pull requests in
      <a href={leapview.url}>LeapView</a> since {since}: one point each, in the order they landed, from my first week
      (violet) to my latest (lime).
    </span>
  </p>
</section>

<script>
  // Shows the time in Mumbai, so people abroad know whether I'm likely to reply soon.
  const el = document.querySelector<HTMLElement>('[data-local-time]');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });
    const tick = () => (el.textContent = `${format.format(new Date())} here`);
    tick();
    setInterval(tick, 30_000);
  }

  // The galaxy loads once the page is idle, so the photo paints first; on Save-Data it stays off.
  const back = document.querySelector<HTMLCanvasElement>('canvas.galaxy.back');
  const front = document.querySelector<HTMLCanvasElement>('canvas.galaxy.front');
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
  if (back && front && !saveData) {
    const weeks: number[] = JSON.parse(back.dataset.weeks ?? '[]');
    const load = () => import('../scripts/galaxy').then(({ mountGalaxy }) => mountGalaxy(back, front, weeks));
    if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 1500 });
    else setTimeout(load, 300);
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-content: center;
    min-height: calc(100svh - 4.5rem);
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  /* Wide screens: the text on the left, the photo and its galaxy on the right. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      column-gap: 4rem;
    }

    .text {
      grid-row: 1;
      align-self: center;
    }

    .visual {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }

    .legend {
      grid-column: 1;
      grid-row: 2;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.95rem 0.4rem 0.75rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    backdrop-filter: blur(12px);
  }

  .status:hover {
    border-color: var(--accent);
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0.75rem var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: ping 2s var(--ease-out) infinite;
    }
  }

  @keyframes ping {
    to {
      opacity: 0;
      scale: 3;
    }
  }

  h1 {
    margin-top: 1.75rem;
    font-size: var(--step-5);
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  /* The surname in italic, lit in the signal colour. */
  .last {
    color: var(--accent);
    font-style: italic;
    text-shadow: 0 0 0.35em color-mix(in srgb, var(--accent) 35%, transparent);
  }

  :global([data-theme='light']) .last {
    text-shadow: none;
  }

  /* Each letter is its own piece of type: they flip up into place on load and lift when the
     pointer passes over them. */
  .word {
    display: block;
    perspective: 40rem;
  }

  .char {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .char {
      animation: flip 800ms var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 45ms);
      transition: transform 350ms var(--ease-out);
    }

    .char:hover {
      transform: translateY(-0.08em) rotate(-4deg);
    }
  }

  @keyframes flip {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.3em) rotateX(-90deg);
    }
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .role strong {
    color: var(--fg);
    font-weight: 600;
  }

  .sep {
    opacity: 0.6;
  }

  .time {
    color: var(--accent);
  }

  .pitch {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.15;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* On phones the primary action takes its own row so the other three fit on one line. */
  @media (max-width: 30rem) {
    .actions .primary {
      flex-basis: 100%;
    }

    .actions .button:not(.primary) {
      flex: 1 1 0;
      padding-inline: 0.5rem;
    }
  }

  /* The photo, large, in a glass frame. The galaxy's ring is drawn on two canvases over the same box,
     one behind the photo and one in front, so the ring passes behind it and comes round in front. */
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(2rem, 1rem + 5vw, 5rem);
  }

  .galaxy {
    position: absolute;
    top: -14%;
    left: -24%;
    width: 148%;
    height: 128%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1200ms var(--ease-out);
  }

  .galaxy:global(.is-ready) {
    opacity: 1;
  }

  .galaxy.front {
    z-index: 2;
  }

  /* Where the photo fills the width, the ring's near half would cross the caption; only the far
     half is drawn, peeking out around the card. */
  @media (max-width: 63.99rem) {
    .galaxy.front {
      display: none;
    }
  }

  .portrait {
    position: relative;
    z-index: 1;
    width: min(100%, 30rem);
    padding: 0.7rem 0.7rem 0.9rem;
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 0.45rem);
    object-fit: cover;
  }

  .portrait figcaption {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0.35rem 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  .legend {
    display: flex;
    gap: 0.9rem;
    max-width: 40rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--step--1);
  }

  .legend strong {
    color: var(--fg);
  }

  /* A swatch of the colour scale the points use, oldest to newest. */
  .swatch {
    flex: none;
    width: 0.6rem;
    margin-block: 0.3rem;
    border-radius: 999px;
    background: linear-gradient(var(--accent-2), var(--accent));
  }

  @media (prefers-reduced-motion: no-preference) {
    .status,
    .role,
    .pitch,
    .actions,
    .portrait,
    .legend {
      animation: rise 900ms var(--ease-out) backwards;
    }

    .role {
      animation-delay: 350ms;
    }

    .pitch {
      animation-delay: 450ms;
    }

    .actions {
      animation-delay: 550ms;
    }

    .portrait {
      animation-delay: 300ms;
    }

    .legend {
      animation-delay: 850ms;
    }

    :global(.intro) .char {
      animation-delay: calc(1100ms + var(--i) * 45ms);
    }

    :global(.intro) .status {
      animation-delay: 1100ms;
    }

    :global(.intro) .role {
      animation-delay: 1450ms;
    }

    :global(.intro) .pitch {
      animation-delay: 1550ms;
    }

    :global(.intro) .actions {
      animation-delay: 1650ms;
    }

    :global(.intro) .portrait {
      animation-delay: 1400ms;
    }

    :global(.intro) .legend {
      animation-delay: 1950ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(1.25rem);
    }
  }
</style>
