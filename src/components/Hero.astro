---
import { Image } from 'astro:assets';
import photo from '../assets/ganesh.jpg';
import { person, hero, leapview, projects } from '../data/profile';
import { dayMonth, monthYear } from '../lib/format';

// Scanning order: the name, who and where, the one-line offer, the actions. Beside them, the photo,
// large, with three glass notes pinned around it, each something a visitor wants to know: how much
// I ship at LeapView, what I build with, and what time it is for me right now.
const [first, ...rest] = person.name.split(' ');
const last = rest.join(' ');
const { mergedPRs, firstMerged, weekly } = leapview.stats;
const since = firstMerged ? monthYear(firstMerged) : leapview.joined;
const busiest = weekly.reduce((top, w) => (w.merged > top.merged ? w : top), weekly[0]);
const max = Math.max(busiest?.merged ?? 1, 1);

// LeapView is Go on DuckDB; then the tools my own projects use most often.
const counts = new Map<string, number>();
for (const tool of projects.flatMap((p) => p.stack)) counts.set(tool, (counts.get(tool) ?? 0) + 1);
const toolkit = ['Go', 'DuckDB', ...[...counts].sort((a, b) => b[1] - a[1]).map(([tool]) => tool)].slice(0, 6);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="text">
    <a class="status" href="#freelance"><span class="pulse" aria-hidden="true"></span>Taking on freelance projects</a>

    <h1 id="hero-name">
      <span class="visually-hidden">{person.name}</span>
      <span class="word" aria-hidden="true">
        {[...first].map((char, i) => <span class="char" style={`--i:${i}`}>{char}</span>)}
      </span>
      <span class="word last" aria-hidden="true">
        {[...last].map((char, i) => <span class="char" style={`--i:${i + first.length}`}>{char}</span>)}
      </span>
    </h1>

    <p class="role">
      <strong>{person.role}</strong> at <a href={person.companyUrl}>{person.company}</a>
      <span class="sep" aria-hidden="true">·</span>
      {person.location}
    </p>
    <p class="pitch">{hero.lede}</p>
    <div class="actions">
      <a class="button primary" href="#contact" data-magnet>Work with me</a>
      <a class="button" href={`mailto:${person.email}`} data-magnet>Email</a>
      <a class="button" href={person.links.github} data-magnet>GitHub</a>
      <a class="button" href={person.links.linkedin} data-magnet>LinkedIn</a>
    </div>
  </div>

  <div class="visual" data-parallax>
    <figure class="portrait card" data-tilt>
      <Image
        src={photo}
        alt={`${person.name} leaning on a balcony railing at night`}
        widths={[480, 640, 800, 960, 1200]}
        format="webp"
        quality={92}
        sizes="(min-width: 64rem) 30rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        <span>{person.name}</span>
        <span class="muted">{person.role}, {person.company}</span>
      </figcaption>
    </figure>

    <a class="note pace" href="#work" style="--depth: 1.6">
      <span class="label">LeapView, since {since}</span>
      <span class="figure"><strong>{mergedPRs}</strong> merged pull requests</span>
      <span class="bars" aria-hidden="true">
        {weekly.map((w) => <i class:list={{ peak: w === busiest }} style={`--h:${Math.max(6, (w.merged / max) * 100)}%`} />)}
      </span>
      {busiest && <span class="label">Busiest week: {busiest.merged}, week of {dayMonth(busiest.week)}</span>}
    </a>

    <div class="note kit" style="--depth: 1">
      <span class="label">What I build with</span>
      <ul>
        {toolkit.map((tool) => <li>{tool}</li>)}
      </ul>
    </div>

    <a class="note clock" href={`mailto:${person.email}`} style="--depth: 2.2">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
      <span>
        <span class="label">My time, {person.location.split(',')[0]}</span>
        <strong class="time" data-local-time>{person.timezone}</strong>
        <span class="label link">Email me</span>
      </span>
    </a>
  </div>
</section>

<script>
  // Shows the time in Mumbai, so people abroad know whether I'm likely to reply soon.
  const el = document.querySelector<HTMLElement>('[data-local-time]');
  if (el) {
    const format = new Intl.DateTimeFormat('en-GB', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' });
    const tick = () => (el.textContent = format.format(new Date()));
    tick();
    setInterval(tick, 30_000);
  }

  // The notes sit at different depths: with a mouse they shift a few pixels against the pointer,
  // nearer notes more, updated at most once a frame. Nothing moves on its own.
  const visual = document.querySelector<HTMLElement>('[data-parallax]');
  if (visual && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    let queued = false;
    const at = { x: 0, y: 0 };
    visual.closest('section')?.addEventListener('pointermove', (event) => {
      at.x = event.clientX / innerWidth - 0.5;
      at.y = event.clientY / innerHeight - 0.5;
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        visual.style.setProperty('--px', at.x.toFixed(3));
        visual.style.setProperty('--py', at.y.toFixed(3));
      });
    });
  }
</script>

<style>
  .hero {
    display: grid;
    gap: 2.5rem;
    align-content: center;
    min-height: calc(100svh - 4.5rem);
    padding-block: clamp(2rem, 1rem + 4vw, 4rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  /* Wide screens: the text on the left, the photo and its notes on the right. */
  @media (min-width: 64rem) {
    .hero {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      column-gap: 4rem;
    }

    .text {
      grid-row: 1;
      align-self: center;
    }

    .visual {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: center;
    }
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.4rem 0.95rem 0.4rem 0.75rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    background: var(--glass);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    backdrop-filter: blur(12px);
  }

  .status:hover {
    border-color: var(--accent);
  }

  .pulse {
    position: relative;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0.75rem var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .pulse::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--accent);
      animation: ping 2s var(--ease-out) infinite;
    }
  }

  @keyframes ping {
    to {
      opacity: 0;
      scale: 3;
    }
  }

  h1 {
    margin-top: 1.75rem;
    font-size: var(--step-5);
    line-height: 0.86;
    letter-spacing: -0.035em;
  }

  /* The surname in italic, lit in the signal colour. */
  .last {
    color: var(--accent);
    font-style: italic;
    text-shadow: 0 0 0.35em color-mix(in srgb, var(--accent) 35%, transparent);
  }

  :global([data-theme='light']) .last {
    text-shadow: none;
  }

  /* Each letter is its own piece of type: they flip up into place on load and lift when the
     pointer passes over them. */
  .word {
    display: block;
    perspective: 40rem;
  }

  .char {
    display: inline-block;
    transform-origin: 50% 100%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .char {
      animation: flip 800ms var(--ease-out) backwards;
      animation-delay: calc(var(--i) * 45ms);
      transition: transform 350ms var(--ease-out);
    }

    .char:hover {
      transform: translateY(-0.08em) rotate(-4deg);
    }
  }

  @keyframes flip {
    from {
      opacity: 0;
      filter: blur(12px);
      transform: translateY(0.3em) rotateX(-90deg);
    }
  }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 1.75rem;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
  }

  .role strong {
    color: var(--fg);
    font-weight: 600;
  }

  .sep {
    opacity: 0.6;
  }

  .pitch {
    max-width: 30ch;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.15;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2.25rem;
  }

  /* On phones the primary action takes its own row so the other three fit on one line. */
  @media (max-width: 30rem) {
    .actions .primary {
      flex-basis: 100%;
    }

    .actions .button:not(.primary) {
      flex: 1 1 0;
      padding-inline: 0.5rem;
    }
  }

  /* The photo, large, in a glass frame, with the notes pinned over its edges. */
  .visual {
    position: relative;
    display: grid;
    place-items: center;
    padding-block: clamp(2rem, 1rem + 5vw, 5rem);
  }

  .portrait {
    position: relative;
    z-index: 1;
    width: min(100%, 30rem);
    padding: 0.7rem 0.7rem 0.9rem;
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: calc(var(--radius) - 0.45rem);
    object-fit: cover;
  }

  /* Other tilting cards lift their first child towards the viewer; for the photo that would scale it
     up a few percent and soften it, so it stays flat on the card. */
  .portrait:hover > img {
    transform: none;
  }

  .portrait figcaption {
    display: grid;
    gap: 0.1rem;
    padding: 0.85rem 0.35rem 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }

  /* A note: a small glass card pinned over the photo's edge. */
  .note {
    position: absolute;
    z-index: 2;
    display: grid;
    gap: 0.35rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--glass-line);
    border-radius: 1rem;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    color: var(--fg);
    text-decoration: none;
    box-shadow: 0 1.5rem 3rem -1rem var(--haze);
    backdrop-filter: blur(16px) saturate(150%);
    translate: calc(var(--px, 0) * var(--depth) * -14px) calc(var(--py, 0) * var(--depth) * -14px);
  }

  a.note:hover {
    border-color: var(--accent);
  }

  .label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
  }

  .note strong {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1;
  }

  /* How much I ship: the weekly counts as bars, the busiest in the signal colour. */
  .pace {
    top: 9%;
    left: -2.5rem;
    width: 14.5rem;
  }

  .figure {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.85rem;
  }

  .figure strong {
    color: var(--accent);
    font-style: italic;
  }

  .bars {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 2.25rem;
    margin-block: 0.2rem;
  }

  .bars i {
    flex: 1;
    height: var(--h);
    border-radius: 2px;
    background: color-mix(in srgb, var(--fg) 30%, transparent);
  }

  .bars i.peak {
    background: var(--accent);
    box-shadow: 0 0 0.6rem color-mix(in srgb, var(--accent) 60%, transparent);
  }

  /* What I build with. */
  .kit {
    top: 44%;
    right: -1.25rem;
    width: 12rem;
  }

  .kit ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .kit li {
    padding: 0.15rem 0.55rem;
    border: 1px solid var(--glass-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }

  /* My time now, for anyone deciding whether to write. */
  .clock {
    bottom: 24%;
    left: -3rem;
    grid-auto-flow: column;
    align-items: center;
    gap: 0.8rem;
  }

  .clock > span {
    display: grid;
    gap: 0.15rem;
  }

  .clock svg {
    width: 2rem;
    height: 2rem;
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  .clock strong {
    font-size: 1.6rem;
  }

  .link {
    color: var(--accent);
  }

  /* Narrow screens: the photo keeps its whole width clear and the notes sit below it, the LeapView
     note across the full width and the other two side by side. */
  @media (max-width: 63.99rem) {
    .visual {
      justify-self: center;
      width: min(100%, 30rem);
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
      place-items: stretch;
      padding-block: 0;
    }

    .portrait {
      grid-column: 1 / -1;
      justify-self: center;
    }

    .note {
      position: static;
      width: auto;
      padding: 0.8rem 0.9rem;
      translate: none;
    }

    .pace {
      grid-column: 1 / -1;
    }

    .clock {
      align-content: center;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .note {
      transition:
        translate 500ms var(--ease-out),
        border-color 200ms;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .status,
    .role,
    .pitch,
    .actions,
    .portrait,
    .note {
      animation: rise 900ms var(--ease-out) backwards;
    }

    .role {
      animation-delay: 350ms;
    }

    .pitch {
      animation-delay: 450ms;
    }

    .actions {
      animation-delay: 550ms;
    }

    .portrait {
      animation-delay: 300ms;
    }

    .pace {
      animation-delay: 650ms;
    }

    .kit {
      animation-delay: 800ms;
    }

    .clock {
      animation-delay: 950ms;
    }

    :global(.intro) .char {
      animation-delay: calc(1100ms + var(--i) * 45ms);
    }

    :global(.intro) .status {
      animation-delay: 1100ms;
    }

    :global(.intro) .role {
      animation-delay: 1450ms;
    }

    :global(.intro) .pitch {
      animation-delay: 1550ms;
    }

    :global(.intro) .actions {
      animation-delay: 1650ms;
    }

    :global(.intro) .portrait {
      animation-delay: 1400ms;
    }

    :global(.intro) .note {
      animation-delay: 1800ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(8px);
      transform: translateY(1.25rem);
    }
  }
</style>
